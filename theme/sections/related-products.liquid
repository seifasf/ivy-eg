{{ 'section-product.css' | asset_url | stylesheet_tag }}

<section class="related-products section-padding" id="Related-{{ section.id }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <product-recommendations
      class="related-products__grid grid grid--4"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for rec_product in recommendations.products -%}
          {% render 'product-card', product: rec_product, lazy_load: true %}
        {%- endfor -%}
      {%- elsif section.settings.show_placeholder -%}
        <p class="related-products__empty text-muted">{{ 'products.product.recommendations.empty' | t }}</p>
      {%- endif -%}
    </product-recommendations>
  </div>
</section>

{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show message when empty",
      "default": false
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
