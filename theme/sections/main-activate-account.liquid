{{ 'customer.css' | asset_url | stylesheet_tag }}

<section class="customer-section">
  <div class="customer-layout customer-layout--narrow">
    <div class="customer-header">
      <h1 class="customer-header__title">{{ 'customer.activate_account.title' | t }}</h1>
      <p class="customer-header__subtitle">{{ 'customer.activate_account.subtext' | t }}</p>
    </div>

    <div class="customer-card">
      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="customer-errors" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
          <input type="password" name="customer[password]" id="ActivatePassword" class="field__input" autocomplete="new-password">
        </div>
        <div class="field">
          <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
          <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" class="field__input" autocomplete="new-password">
        </div>

        <div class="customer-form__footer" style="flex-direction: row; flex-wrap: wrap; gap: var(--gap-md);">
          <button type="submit" class="btn btn--primary btn--pill">{{ 'customer.activate_account.submit' | t }}</button>
          <button type="submit" class="btn btn--secondary" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_activate_account.name",
  "tag": "section",
  "class": "section-main-activate-account"
}
{% endschema %}
