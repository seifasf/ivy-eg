{{ 'section-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
-%}

<section class="product section-padding" id="Product-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container">
    {% render 'breadcrumbs', class: 'product__breadcrumbs' %}

    <div class="product__layout">
      <div class="product__media-column">
        {% render 'product-media-gallery', product: product, enable_zoom: section.settings.enable_zoom %}
      </div>

      <div class="product__info-column">
        {%- form 'product', product, id: form_id, class: 'product__form', data-product-form: '' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div class="product__block product__block--app" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>

              {%- when 'title' -%}
                <div class="product__block product__block--title" {{ block.shopify_attributes }}>
                  <h1 class="product__title">{{ product.title | escape }}</h1>
                  {%- if block.settings.show_vendor and product.vendor != blank -%}
                    <p class="product__vendor text-muted">{{ product.vendor | escape }}</p>
                  {%- endif -%}
                </div>

              {%- when 'price' -%}
                <div class="product__block product__block--price" data-product-price {{ block.shopify_attributes }}>
                  {% render 'price', product: product, use_variant: true, show_badges: block.settings.show_badges, class: 'product__price' %}
                </div>

              {%- when 'inventory' -%}
                <div class="product__block product__block--inventory" {{ block.shopify_attributes }} data-inventory-status>
                  {%- if current_variant.inventory_management == 'shopify' -%}
                    {%- if current_variant.inventory_quantity <= 0 and current_variant.available == false -%}
                      <p class="product__inventory product__inventory--sold-out">{{ 'products.product.inventory.out_of_stock' | t }}</p>
                    {%- elsif current_variant.inventory_quantity <= block.settings.inventory_threshold and current_variant.inventory_quantity > 0 -%}
                      <p class="product__inventory product__inventory--low">
                        {{ 'products.product.inventory.low_stock' | t: count: current_variant.inventory_quantity }}
                      </p>
                    {%- elsif block.settings.show_in_stock -%}
                      <p class="product__inventory product__inventory--in-stock">{{ 'products.product.inventory.in_stock' | t }}</p>
                    {%- endif -%}
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                <div class="product__block product__block--variants" {{ block.shopify_attributes }}>
                  {% render 'product-variant-picker', product: product, block: block, form_id: form_id %}
                </div>

              {%- when 'quantity' -%}
                <div class="product__block product__block--quantity" {{ block.shopify_attributes }}>
                  <label class="product__quantity-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                  <div class="quantity product__quantity">
                    <button type="button" class="quantity__button" data-quantity-minus aria-label="−">
                      <span aria-hidden="true">−</span>
                    </button>
                    <input
                      id="Quantity-{{ section.id }}"
                      class="quantity__input"
                      type="number"
                      name="quantity"
                      value="{{ block.settings.default_quantity | default: 1 }}"
                      min="1"
                      form="{{ form_id }}"
                    >
                    <button type="button" class="quantity__button" data-quantity-plus aria-label="+">
                      <span aria-hidden="true">+</span>
                    </button>
                  </div>
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product__block product__block--buy" {{ block.shopify_attributes }}>
                  {% render 'buy-buttons', product: product, block: block, form: form %}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__block product__block--description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'collapsible_tab' -%}
                <details class="product__accordion" {{ block.shopify_attributes }}>
                  <summary class="product__accordion-summary">
                    <span>{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
                    {% render 'icon', icon: 'chevron-down', size: 18 %}
                  </summary>
                  <div class="product__accordion-content rte">
                    {%- if block.settings.page.content != blank -%}
                      {{ block.settings.page.content }}
                    {%- else -%}
                      {{ block.settings.content }}
                    {%- endif -%}
                  </div>
                </details>

              {%- when 'shipping_info' -%}
                <div class="product__block product__block--shipping" {{ block.shopify_attributes }}>
                  <p class="product__shipping">
                    {%- if block.settings.text != blank -%}
                      {{ block.settings.text }}
                    {%- else -%}
                      {{ 'products.product.shipping.default' | t }}
                    {%- endif -%}
                  </p>
                </div>

              {%- when 'size_guide' -%}
                {%- if block.settings.page != blank -%}
                  <details class="product__accordion" {{ block.shopify_attributes }}>
                    <summary class="product__accordion-summary">
                      <span>{{ block.settings.heading | default: 'products.product.size_guide' | t }}</span>
                      {% render 'icon', icon: 'chevron-down', size: 18 %}
                    </summary>
                    <div class="product__accordion-content rte">
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                {%- endif -%}

              {%- when 'complementary' -%}
                <div class="product__block product__block--complementary" {{ block.shopify_attributes }}>
                  <product-recommendations
                    class="product-recommendations"
                    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.product_limit }}&intent=complementary"
                  >
                    {%- if recommendations.performed and recommendations.products_count > 0 -%}
                      <h2 class="product__complementary-title">{{ block.settings.heading | escape }}</h2>
                      <div class="product__complementary-grid grid grid--2">
                        {%- for rec_product in recommendations.products -%}
                          {% render 'product-card', product: rec_product %}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </product-recommendations>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    </div>
  </div>

  {%- if section.settings.enable_sticky_atc -%}
    <div class="product-sticky-atc" data-sticky-atc hidden aria-hidden="true">
      <div class="container product-sticky-atc__inner">
        <div class="product-sticky-atc__info">
          <span class="product-sticky-atc__title">{{ product.title | escape }}</span>
          {% render 'price', product: product, use_variant: true, class: 'product-sticky-atc__price' %}
        </div>
        <button type="button" class="btn btn--primary btn--pill" data-sticky-atc-button>
          {{ 'products.product.add_to_cart' | t }}
        </button>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-recently-viewed-product>
    {
      "id": {{ product.id | json }},
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "featured_image": {{ product.featured_image | image_url: width: 600 | json }}
    }
  </script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 5000 | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_image -%}
      "image": [{{ product.featured_image | image_url: width: 1200 | json }}],
      {%- endif -%}
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
        "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
        "offerCount": {{ product.variants.size | json }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
  </script>
</section>

<script>
  document.querySelector('#Product-{{ section.id }} .product__quantity')?.addEventListener('click', (e) => {
    const input = e.currentTarget.querySelector('.quantity__input');
    if (!input) return;
    if (e.target.closest('[data-quantity-minus]')) {
      input.value = Math.max(1, parseInt(input.value, 10) - 1);
    }
    if (e.target.closest('[data-quantity-plus]')) {
      input.value = parseInt(input.value, 10) + 1;
    }
  });
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable sticky add to cart bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Show vendor",
          "default": false
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_badges",
          "label": "Show sale badge",
          "default": true
        }
      ]
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "inventory_threshold",
          "min": 0,
          "max": 20,
          "step": 1,
          "label": "Low stock threshold",
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_in_stock",
          "label": "Show in stock message",
          "default": true
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker type",
          "options": [
            { "value": "button", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "button"
        },
        {
          "type": "checkbox",
          "id": "enable_swatches",
          "label": "Enable color swatches",
          "default": true
        }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity selector",
      "limit": 1,
      "settings": [
        {
          "type": "number",
          "id": "default_quantity",
          "label": "Default quantity",
          "default": 1
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page content"
        }
      ]
    },
    {
      "type": "shipping_info",
      "name": "Shipping info",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "size_guide",
      "name": "Size guide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Size guide"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Size guide page"
        }
      ]
    },
    {
      "type": "complementary",
      "name": "Complementary products",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Complete the look"
        },
        {
          "type": "range",
          "id": "product_limit",
          "min": 2,
          "max": 6,
          "step": 1,
          "label": "Product count",
          "default": 4
        }
      ]
    },
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
