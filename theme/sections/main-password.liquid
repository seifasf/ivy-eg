{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<section class="password-section">
  {%- if section.settings.heading != blank -%}
    <h2 class="password-section__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if shop.password_message != blank -%}
    <div class="password-section__message rte">{{ shop.password_message }}</div>
  {%- elsif section.settings.message != blank -%}
    <p class="password-section__message">{{ section.settings.message | escape }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'password-section__form' -%}
    {%- if form.errors -%}
      <div class="contact-form__errors" role="alert">
        {{ form.errors.messages.form }}
      </div>
    {%- endif -%}

    <div class="field">
      <label class="field__label visually-hidden" for="Password">{{ 'password.password_label' | t }}</label>
      <input
        type="password"
        name="password"
        id="Password"
        class="field__input"
        placeholder="{{ 'password.password_label' | t }}"
        autocomplete="current-password"
      >
    </div>
    <button type="submit" class="btn btn--primary btn--pill" style="inline-size: 100%; margin-block-start: var(--gap-sm);">
      {{ 'password.password_submit' | t }}
    </button>
  {%- endform -%}

  <p class="password-section__admin">
    {{ 'password.admin_link_html' | t }}
  </p>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_password.settings.heading.label",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "t:sections.main_password.settings.message.label"
    }
  ]
}
{% endschema %}
