{% render 'section-home-assets' %}

<section
  id="VideoHero-{{ section.id }}"
  class="video-hero ivy-section"
  style="--video-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="video-hero__media" aria-hidden="true">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          image_size: '1920x'
      }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0"
          title="{{ section.settings.heading | escape }}"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1"
          title="{{ section.settings.heading | escape }}"
          allow="autoplay; encrypted-media"
          allowfullscreen
          loading="lazy"
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.cover_image != blank -%}
      {{
        section.settings.cover_image
        | image_url: width: 1920
        | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 1920'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="video-hero__overlay" aria-hidden="true"></div>
  <div class="video-hero__content container" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="video-hero__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="video-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--pill">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.video_hero.name",
  "tag": "section",
  "class": "section-video-hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video_hero.settings.video.label",
      "info": "t:sections.video_hero.settings.video.info"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video_hero.settings.video_url.label"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video_hero.settings.cover_image.label",
      "info": "t:sections.video_hero.settings.cover_image.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.video_hero.settings.overlay_opacity.label",
      "default": 45
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.video_hero.settings.heading.label",
      "default": "Your Everyday Wingman"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.video_hero.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.video_hero.settings.button_label.label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.video_hero.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.video_hero.presets.name",
      "settings": {
        "heading": "Your Everyday Wingman",
        "button_label": "Explore Collection"
      }
    }
  ]
}
{% endschema %}
