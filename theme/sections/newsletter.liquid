{% render 'section-home-assets' %}

<section id="Newsletter-{{ section.id }}" class="ivy-section ivy-section--surface section-padding">
  <div class="container">
    <div class="newsletter__panel" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="ivy-section__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ivy-section__subtitle" style="margin-block-end: 0;">{{ section.settings.text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__form-row">
          <div class="field" style="margin-block-end: 0; flex: 1;">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
              {{ 'sections.newsletter.email_label' | t }}
            </label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="field__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'sections.newsletter.email_placeholder' | t }}"
              autocomplete="email"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>
          <button type="submit" class="btn btn--primary btn--pill">
            {%- if section.settings.button_label != blank -%}
              {{ section.settings.button_label }}
            {%- else -%}
              {{ 'sections.newsletter.submit' | t }}
            {%- endif -%}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="newsletter__success">{{ 'sections.newsletter.success' | t }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <p class="newsletter__error">
            {%- if form.errors.messages.email != blank -%}
              {{ form.errors.messages.email }}
            {%- else -%}
              {{ 'sections.newsletter.error' | t }}
            {%- endif -%}
          </p>
        {%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.newsletter.settings.text.label",
      "default": "Be the first to know about new drops and exclusive offers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
