{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<section class="page-section page-section--compact">
  <div class="page-content not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1 class="not-found__title">{{ section.settings.heading | escape }}</h1>
    <p class="not-found__text">{{ section.settings.text | escape }}</p>
    <div class="not-found__actions">
      <a href="{{ routes.root_url }}" class="btn btn--primary btn--pill">{{ section.settings.home_label | escape }}</a>
      <a href="{{ routes.collections_url }}" class="btn btn--secondary btn--pill">{{ section.settings.collections_label | escape }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_404.settings.heading.label",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.main_404.settings.text.label",
      "default": "The page you're looking for doesn't exist or has moved."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "t:sections.main_404.settings.home_label.label",
      "default": "Back to home"
    },
    {
      "type": "text",
      "id": "collections_label",
      "label": "t:sections.main_404.settings.collections_label.label",
      "default": "Browse collections"
    }
  ]
}
{% endschema %}
