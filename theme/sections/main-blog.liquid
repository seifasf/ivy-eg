{{ 'section-pages.css' | asset_url | stylesheet_tag }}

<section class="page-section">
  <div class="page-hero">
    <h1 class="page-hero__title">{{ blog.title | escape }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="page-hero__subtitle">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="page-content" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div class="blog-grid">
          {%- for article in blog.articles -%}
            <article class="blog-card">
              {%- if article.image -%}
                <a href="{{ article.url }}" class="blog-card__media">
                  {{
                    article.image
                    | image_url: width: 800
                    | image_tag: class: 'blog-card__image', loading: 'lazy', alt: article.image.alt | default: article.title
                  }}
                </a>
              {%- endif -%}
              <div class="blog-card__body">
                <p class="blog-card__meta">
                  {{ article.published_at | time_tag: format: 'date' }}
                  {%- if article.author != blank -%}
                    · {{ article.author | escape }}
                  {%- endif -%}
                </p>
                <h2 class="blog-card__title">
                  <a href="{{ article.url }}">{{ article.title | escape }}</a>
                </h2>
                {%- if article.excerpt_or_content != blank -%}
                  <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</p>
                {%- endif -%}
                <a href="{{ article.url }}" class="blog-card__link">{{ 'blogs.article.read_more' | t }}</a>
              </div>
            </article>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div style="margin-block-start: var(--gap-2xl);">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="empty-state">{{ 'blogs.general.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.main_blog.settings.subheading.label"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "label": "t:sections.main_blog.settings.articles_per_page.label",
      "default": 9
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
