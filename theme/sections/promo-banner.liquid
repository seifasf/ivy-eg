{% render 'section-home-assets' %}

<section id="PromoBanner-{{ section.id }}" class="ivy-section section-padding">
  <div class="container">
    <div
      class="promo-banner"
      style="{% if section.settings.background_color != blank and section.settings.image == blank %}background-color: {{ section.settings.background_color }};{% endif %}"
      data-reveal
    >
      {%- if section.settings.image != blank -%}
        <div class="promo-banner__media" aria-hidden="true">
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1600'
          }}
          <div class="video-hero__overlay" style="--video-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
        </div>
      {%- endif -%}

      <div class="promo-banner__inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="ivy-section__title" style="text-align: start; margin-block-end: 0;">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="ivy-section__subtitle" style="text-align: start; margin: 0;">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="promo-banner__blocks">
            {%- for block in section.blocks -%}
              {%- if block.settings.button_label != blank -%}
                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="btn {% if block.settings.style == 'primary' %}btn--primary{% else %}btn--secondary{% endif %} btn--pill"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--pill">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "tag": "section",
  "class": "section-promo-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.promo_banner.settings.image.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.promo_banner.settings.background_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:sections.promo_banner.settings.overlay_opacity.label",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.promo_banner.settings.heading.label",
      "default": "New Season Drop"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.promo_banner.settings.text.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.promo_banner.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.promo_banner.settings.button_link.label"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "t:sections.promo_banner.blocks.button.name",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.promo_banner.blocks.button.settings.button_label.label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.promo_banner.blocks.button.settings.button_link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.promo_banner.blocks.button.settings.style.label",
          "options": [
            { "value": "primary", "label": "t:sections.promo_banner.blocks.button.settings.style.options.primary" },
            { "value": "secondary", "label": "t:sections.promo_banner.blocks.button.settings.style.options.secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_banner.presets.name",
      "blocks": [
        {
          "type": "button",
          "settings": { "button_label": "Explore Collection", "style": "primary" }
        }
      ]
    }
  ]
}
{% endschema %}
