<footer class="site-footer">
  <div class="site-footer__inner">
    {%- if settings.logo != blank -%}
      {{
        settings.logo
        | image_url: width: 300
        | image_tag: class: 'site-footer__logo', widths: '150, 300', alt: shop.name, loading: 'lazy'
      }}
    {%- else -%}
      <span class="site-footer__wordmark">{{ shop.name }}</span>
    {%- endif -%}

    <p class="site-footer__tagline">
      {%- if section.settings.slogan != blank -%}
        {{ section.settings.slogan | escape }}
      {%- else -%}
        {{ 'general.tagline' | t }}
      {%- endif -%}
    </p>

    {%- if section.blocks.size > 0 -%}
      <div class="site-footer__menus">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.menu != blank -%}
                <div class="site-footer__menu-column" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="site-footer__menu-heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  <ul class="site-footer__menu-list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            {%- when 'newsletter' -%}
              <div class="site-footer__newsletter" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="site-footer__menu-heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="site-footer__newsletter-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
                {% form 'customer', class: 'site-footer__newsletter-form' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="site-footer__newsletter-row">
                    <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter.email' | t }}</label>
                    <input
                      id="FooterNewsletterEmail"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      placeholder="{{ 'footer.newsletter.placeholder' | t }}"
                      required
                    >
                    <button type="submit" class="btn btn--primary btn--pill">{{ 'footer.newsletter.submit' | t }}</button>
                  </div>
                  {%- if form.posted_successfully? -%}
                    <p class="site-footer__newsletter-success" role="status">{{ 'footer.newsletter.success' | t }}</p>
                  {%- endif -%}
                  {%- if form.errors -%}
                    <p class="site-footer__newsletter-error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                  {%- endif -%}
                {% endform %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% render 'social-icons', class: 'site-footer__social' %}

    {%- if section.settings.show_contact_button -%}
      <a href="{{ pages.contact.url | default: '/pages/contact' }}" class="btn btn--secondary btn--pill site-footer__contact">
        {{ 'footer.contact_us' | t }}
      </a>
    {%- endif -%}

    {%- if section.settings.show_payment_icons -%}
      <div class="site-footer__payment">
        <span class="visually-hidden">{{ 'footer.payment.title' | t }}</span>
        <ul class="site-footer__payment-list" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="site-footer__payment-item">{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="site-footer__localization">
      {% render 'country-localization' %}
      {% render 'language-localization' %}
    </div>

    <p class="site-footer__copyright">
      {{ 'footer.copyright_html' | t: year: 'now' | date: '%Y', shop_name: shop.name }}
    </p>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "slogan",
      "label": "t:sections.footer.settings.slogan.label",
      "default": "Your Everyday Wingman"
    },
    {
      "type": "checkbox",
      "id": "show_contact_button",
      "label": "t:sections.footer.settings.show_contact_button.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.newsletter.settings.heading.label",
          "default": "Newsletter"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.footer.blocks.newsletter.settings.text.label",
          "default": "Be first to know about drops and restocks."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.presets.name",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Help"
          }
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
