{% render 'section-home-assets' %}

<section
  id="Countdown-{{ section.id }}"
  class="ivy-section section-padding countdown"
  data-countdown
  data-end-date="{{ section.settings.end_date | escape }}"
>
  <div class="container">
    <header class="ivy-section__header" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="ivy-section__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="ivy-section__subtitle">{{ section.settings.text }}</p>
      {%- endif -%}
    </header>

    <div class="countdown__timer" data-reveal role="timer" aria-live="polite">
      <div class="countdown__unit">
        <span class="countdown__value" data-countdown-days>00</span>
        <span class="countdown__label">
          {%- if section.settings.label_days != blank -%}{{ section.settings.label_days }}{%- else -%}{{ 'sections.countdown.labels.days' | t }}{%- endif -%}
        </span>
      </div>
      <div class="countdown__unit">
        <span class="countdown__value" data-countdown-hours>00</span>
        <span class="countdown__label">
          {%- if section.settings.label_hours != blank -%}{{ section.settings.label_hours }}{%- else -%}{{ 'sections.countdown.labels.hours' | t }}{%- endif -%}
        </span>
      </div>
      <div class="countdown__unit">
        <span class="countdown__value" data-countdown-minutes>00</span>
        <span class="countdown__label">
          {%- if section.settings.label_minutes != blank -%}{{ section.settings.label_minutes }}{%- else -%}{{ 'sections.countdown.labels.minutes' | t }}{%- endif -%}
        </span>
      </div>
      <div class="countdown__unit">
        <span class="countdown__value" data-countdown-seconds>00</span>
        <span class="countdown__label">
          {%- if section.settings.label_seconds != blank -%}{{ section.settings.label_seconds }}{%- else -%}{{ 'sections.countdown.labels.seconds' | t }}{%- endif -%}
        </span>
      </div>
    </div>

    <p class="countdown__expired">
      {%- if section.settings.expired_message != blank -%}
        {{ section.settings.expired_message }}
      {%- else -%}
        {{ 'sections.countdown.expired' | t }}
      {%- endif -%}
    </p>

    {%- if section.settings.button_label != blank -%}
      <div class="rich-text__buttons mt-lg" style="display: flex; justify-content: center;">
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--pill">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.countdown.name",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.countdown.settings.heading.label",
      "default": "Limited Drop"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.countdown.settings.text.label"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "t:sections.countdown.settings.end_date.label",
      "info": "t:sections.countdown.settings.end_date.info",
      "default": "2026-12-31T23:59:59"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "t:sections.countdown.settings.label_days.label"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "t:sections.countdown.settings.label_hours.label"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "t:sections.countdown.settings.label_minutes.label"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "t:sections.countdown.settings.label_seconds.label"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "t:sections.countdown.settings.expired_message.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.countdown.settings.button_label.label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.countdown.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.countdown.presets.name"
    }
  ]
}
{% endschema %}
