{{ 'customer.css' | asset_url | stylesheet_tag }}

<section class="customer-section">
  <div class="customer-layout customer-layout--narrow">
    <div class="customer-header">
      <h1 class="customer-header__title">{{ 'customer.register.title' | t }}</h1>
      <p class="customer-header__subtitle">{{ section.settings.subheading | escape }}</p>
    </div>

    <div class="customer-card">
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="customer-errors" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
          <input class="field__input" type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
          <input class="field__input" type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
          <input class="field__input" type="email" name="customer[email]" id="RegisterEmail" autocomplete="email">
        </div>
        <div class="field">
          <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
          <input class="field__input" type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password">
        </div>

        <button type="submit" class="btn btn--primary btn--pill" style="inline-size: 100%;">
          {{ 'customer.register.submit' | t }}
        </button>

        <p class="customer-form__footer" style="text-align: center;">
          <a href="{{ routes.account_login_url }}" class="customer-link">{{ 'customer.register.sign_in' | t }}</a>
        </p>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_register.name",
  "tag": "section",
  "class": "section-main-register",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.main_register.settings.subheading.label",
      "default": "Create an account for faster checkout and order history."
    }
  ]
}
{% endschema %}
