{% render 'section-home-assets' %}

<section id="Testimonials-{{ section.id }}" class="ivy-section ivy-section--surface section-padding">
  <div class="container">
    <header class="ivy-section__header" data-reveal>
      {%- if section.settings.title != blank -%}
        <h2 class="ivy-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ivy-section__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <ul
      class="testimonials__grid list-unstyled"
      role="list"
      style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="testimonials__quote" {{ block.shopify_attributes }} data-reveal>
            {%- if block.settings.quote != blank -%}
              <blockquote class="testimonials__quote-text">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
            {%- endif -%}
            {%- if block.settings.author != blank -%}
              <cite class="testimonials__author">&mdash; {{ block.settings.author }}</cite>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="testimonials__quote" data-reveal>
          <blockquote class="testimonials__quote-text">&ldquo;{{ 'sections.testimonials.defaults.quote' | t }}&rdquo;</blockquote>
          <cite class="testimonials__author">&mdash; {{ 'sections.testimonials.defaults.author' | t }}</cite>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.testimonials.settings.title.label",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.testimonials.settings.subtitle.label"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label",
          "default": "IVY is my go-to for clean, premium everyday wear."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author.label",
          "default": "Verified Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Quality you can feel. Minimal design that still stands out.",
            "author": "Ahmed M."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Fast delivery in Egypt and the fit is perfect.",
            "author": "Karim S."
          }
        }
      ]
    }
  ]
}
{% endschema %}
