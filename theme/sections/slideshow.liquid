{% render 'section-home-assets' %}

{%- liquid
  assign slide_count = section.blocks.size
  if slide_count == 0
    assign slide_count = 1
  endif
-%}

<section
  id="Slideshow-{{ section.id }}"
  class="slideshow ivy-section"
  data-slideshow
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="{{ 'sections.slideshow.accessibility.carousel' | t }}"
>
  <div class="slideshow__viewport">
    <div class="slideshow__track" data-slideshow-track>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div
            class="slideshow__slide"
            id="Slide-{{ section.id }}-{{ block.id }}"
            data-slideshow-slide
            {{ block.shopify_attributes }}
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} {{ 'sections.slideshow.accessibility.of' | t }} {{ section.blocks.size }}"
          >
            <div class="slideshow__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 2000
                  | image_tag:
                    loading: 'lazy',
                    sizes: '100vw',
                    widths: '750, 1100, 1500, 2000',
                    alt: block.settings.image.alt | default: block.settings.heading
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="slideshow__overlay" aria-hidden="true"></div>
            <div class="slideshow__content">
              {%- if block.settings.heading != blank -%}
                <h2 class="slideshow__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="slideshow__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link | default: '#' }}" class="btn btn--primary btn--pill">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="slideshow__slide" data-slideshow-slide>
          <div class="slideshow__media">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          <div class="slideshow__overlay" aria-hidden="true"></div>
          <div class="slideshow__content">
            <h2 class="slideshow__heading">{{ 'sections.slideshow.defaults.heading' | t }}</h2>
            <p class="slideshow__text">{{ 'sections.slideshow.defaults.text' | t }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow__controls">
        <button type="button" class="slideshow__arrow" data-slideshow-prev aria-label="{{ 'sections.slideshow.accessibility.previous' | t }}">
          {% render 'icon', icon: 'chevron-left' %}
        </button>
        <button type="button" class="slideshow__arrow" data-slideshow-next aria-label="{{ 'sections.slideshow.accessibility.next' | t }}">
          {% render 'icon', icon: 'chevron-right' %}
        </button>
      </div>
      <div class="slideshow__dots" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="slideshow__dot{% if forloop.first %} is-active{% endif %}"
            data-slideshow-dot
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ 'sections.slideshow.accessibility.slide' | t: number: forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "t:sections.slideshow.settings.autoplay_speed.label",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow.blocks.slide.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "IVY"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.slideshow.blocks.slide.settings.text.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow.blocks.slide.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "Your Everyday Wingman",
            "text": "Premium sporty essentials built for the discerning individual.",
            "button_label": "Explore Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
