{% render 'section-home-assets' %}

{%- liquid
  assign layout = section.settings.layout
  assign layout_class = 'image-with-text__layout--image-left'
  if layout == 'image_right'
    assign layout_class = 'image-with-text__layout--image-right'
  endif
-%}

<section id="ImageWithText-{{ section.id }}" class="ivy-section section-padding">
  <div class="container">
    <div class="image-with-text__layout {{ layout_class }}" data-reveal>
      <div class="image-with-text__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '600, 900, 1200', alt: section.settings.heading
          }}
        {%- else -%}
          {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__richtext rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--primary btn--pill">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout.label",
      "options": [
        { "value": "image_left", "label": "t:sections.image_with_text.settings.layout.options.image_left" },
        { "value": "image_right", "label": "t:sections.image_with_text.settings.layout.options.image_right" }
      ],
      "default": "image_left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_with_text.settings.heading.label",
      "default": "Built for everyday performance"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image_with_text.settings.text.label",
      "default": "<p>Premium sporty essentials designed for confident, minimal style.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.settings.button_link.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.name"
    }
  ]
}
{% endschema %}
