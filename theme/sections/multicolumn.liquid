{% render 'section-home-assets' %}

<section id="Multicolumn-{{ section.id }}" class="ivy-section ivy-section--surface section-padding">
  <div class="container">
    <header class="ivy-section__header" data-reveal>
      {%- if section.settings.title != blank -%}
        <h2 class="ivy-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="ivy-section__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </header>

    <ul
      class="multicolumn__grid list-unstyled"
      role="list"
      style="grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="multicolumn__item" {{ block.shopify_attributes }} data-reveal>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 120
                | image_tag: class: 'multicolumn__icon', loading: 'lazy', alt: block.settings.title
              }}
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="multicolumn__item-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="multicolumn__item-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="multicolumn__item" data-reveal>
            <h3 class="multicolumn__item-title">{{ 'sections.multicolumn.defaults.title' | t }}</h3>
            <p class="multicolumn__item-text">{{ 'sections.multicolumn.defaults.text' | t }}</p>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "class": "section-multicolumn",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.multicolumn.settings.title.label",
      "default": "Why IVY"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:sections.multicolumn.settings.subtitle.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:sections.multicolumn.settings.columns_desktop.label",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label",
          "info": "t:sections.multicolumn.blocks.column.settings.image.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label",
          "default": "Column"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.name",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Premium Quality",
            "text": "Crafted materials built for everyday wear."
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Minimal Design",
            "text": "Confident monochrome style that speaks for itself."
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Egypt Ready",
            "text": "Shipping and support tailored for local customers."
          }
        }
      ]
    }
  ]
}
{% endschema %}
