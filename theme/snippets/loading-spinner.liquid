{% comment %}
  Loading spinner.
  Accepts:
  - class: {String}
  - size: {Number}
{% endcomment %}
{%- assign spinner_size = size | default: 32 -%}
<span class="loading-spinner {{ class }}" role="status" aria-label="{{ 'accessibility.loading' | t }}">
  <svg
    class="loading-spinner__svg"
    width="{{ spinner_size }}"
    height="{{ spinner_size }}"
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <circle cx="16" cy="16" r="13" stroke="currentColor" stroke-width="2" opacity="0.25"/>
    <path d="M16 3a13 13 0 0113 13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
</span>
