{% comment %}
  Pagination for paginate objects.
  Accepts:
  - paginate: {Object} (required)
  - class: {String}
{% endcomment %}
{%- if paginate.pages > 1 -%}
  <nav class="pagination {{ class }}" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li class="pagination__item">
          <a
            href="{{ paginate.previous.url }}"
            class="pagination__link pagination__link--prev"
            aria-label="{{ 'general.pagination.previous' | t }}"
          >
            {% render 'icon', icon: 'chevron-left', size: 20 %}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li class="pagination__item">
            <a href="{{ part.url }}" class="pagination__link" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
              {{ part.title }}
            </a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li class="pagination__item">
              <span class="pagination__link pagination__link--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                {{ part.title }}
              </span>
            </li>
          {%- else -%}
            <li class="pagination__item pagination__item--gap" aria-hidden="true">
              <span class="pagination__ellipsis">{{ part.title }}</span>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li class="pagination__item">
          <a
            href="{{ paginate.next.url }}"
            class="pagination__link pagination__link--next"
            aria-label="{{ 'general.pagination.next' | t }}"
          >
            {% render 'icon', icon: 'chevron-right', size: 20 %}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
