{% comment %}
  Renders an SVG icon.
  Accepts:
  - icon: {String} Icon name (required)
  - class: {String} Additional CSS classes
  - size: {Number} Width/height in px (default 24)
{% endcomment %}
{%- liquid
  assign icon_name = icon | default: 'close'
  assign icon_class = class | default: ''
  assign icon_size = size | default: 24
-%}
<svg
  class="icon icon--{{ icon_name }} {{ icon_class }}"
  aria-hidden="true"
  focusable="false"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  {%- case icon_name -%}
    {%- when 'cart' -%}
      <path d="M2 3h2l1.5 12h13L21 6H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9" cy="20" r="1.5" fill="currentColor"/>
      <circle cx="18" cy="20" r="1.5" fill="currentColor"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
      <path d="M20 20l-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
      <path d="M4 20c0-4 3.5-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'minus' -%}
      <path d="M5 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'check' -%}
      <path d="M5 12l5 5L19 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M9 9v8a3 3 0 103-3V7h3l1-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'facebook' -%}
      <path d="M14 8h3V5h-3c-2.5 0-4 1.5-4 4v2H7v3h3v7h3v-7h2.5L16 12h-3v-1c0-.5.5-1 1-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'twitter' -%}
      <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="M11 10l4 2-4 2v-4z" fill="currentColor"/>
    {%- when 'link' -%}
      <path d="M10 14a4 4 0 010-5.5l1-1a4 4 0 015.5 0M14 10a4 4 0 010 5.5l-1 1a4 4 0 01-5.5 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M3 7l9 6 9-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
      <rect x="14" y="4" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
      <rect x="4" y="14" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
      <rect x="14" y="14" width="6" height="6" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'list' -%}
      <path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'play' -%}
      <path d="M8 5v14l11-7L8 5z" fill="currentColor"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
      <path d="M11 8v6M8 11h6M20 20l-3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
  {%- endcase -%}
</svg>
