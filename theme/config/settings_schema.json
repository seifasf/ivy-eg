[
  {
    "name": "theme_info",
    "theme_name": "IVY",
    "theme_version": "1.0.0",
    "theme_author": "IVY",
    "theme_documentation_url": "https://shopify.dev/themes",
    "theme_support_email": "support@example.com"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Recommended: white/transparent PNG on black. Falls back to IVY wordmark."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 220,
        "step": 4,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_surface_2",
        "label": "Card / panel",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "label": "Text",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_foreground_muted",
        "label": "Muted text",
        "default": "#b0b0b0"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Primary button",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_button_label",
        "label": "Primary button label",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale / error accent",
        "default": "#ff4757"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "inter_n4"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "inter_n7"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "min": 14,
        "max": 18,
        "step": 1,
        "unit": "px",
        "label": "Base font size",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1200
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer",
        "info": "Drawer opens on add-to-cart; page always available at /cart."
      },
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Enable animations",
        "default": true
      }
    ]
  },
  {
    "name": "Free shipping bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_free_shipping_bar",
        "label": "Show free shipping progress",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Threshold (in store currency, minor units ignored \u2014 enter major units e.g. 1000)",
        "default": 1500,
        "info": "Compared against cart total in shop currency."
      }
    ]
  },
  {
    "name": "Social links",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "default": "https://www.instagram.com/ivywear.eg"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL",
        "default": "https://www.tiktok.com/@ivywear.eg"
      },
      {
        "type": "text",
        "id": "social_linktree",
        "label": "Linktree URL",
        "default": "https://linktr.ee/ivyeg"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X (Twitter) URL"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube URL"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "checkbox",
        "id": "predictive_search_enabled",
        "label": "Enable predictive search",
        "default": true
      }
    ]
  },
  {
    "name": "Currency & language",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_currency_selector",
        "label": "Show country/currency selector",
        "default": true,
        "info": "Requires Shopify Markets."
      },
      {
        "type": "checkbox",
        "id": "show_language_selector",
        "label": "Show language selector",
        "default": true
      }
    ]
  }
]
