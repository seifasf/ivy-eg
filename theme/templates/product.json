{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {
            "show_vendor": false
          }
        },
        "price": {
          "type": "price",
          "settings": {
            "show_badges": true
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "inventory_threshold": 5,
            "show_in_stock": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "enable_swatches": true
          }
        },
        "quantity": {
          "type": "quantity",
          "settings": {
            "default_quantity": 1
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "description": {
          "type": "description"
        },
        "shipping": {
          "type": "shipping_info",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "price",
        "inventory",
        "variant_picker",
        "quantity",
        "buy_buttons",
        "description",
        "shipping"
      ],
      "settings": {
        "enable_zoom": true,
        "enable_sticky_atc": true
      }
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "products_to_show": 4,
        "show_placeholder": false
      }
    },
    "recently_viewed": {
      "type": "recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "products_to_show": 4
      }
    }
  },
  "order": ["main", "related", "recently_viewed"]
}
