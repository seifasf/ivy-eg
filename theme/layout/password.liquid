<!doctype html>
<html
  class="no-js password-layout"
  lang="{{ request.locale.iso_code }}"
  dir="{{ localization.language.primary_direction | default: 'ltr' }}"
>
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'section-pages.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>

  <body class="password-page">
    <a class="skip-to-content visually-hidden-focusable" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    <div class="password-page__wrapper">
      <header class="password-page__header">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag:
              class: 'password-page__logo',
              widths: '200, 400',
              alt: shop.name,
              loading: 'eager'
          }}
        {%- else -%}
          <span class="password-page__wordmark">{{ shop.name }}</span>
        {%- endif -%}
        <p class="password-page__tagline">{{ 'general.tagline' | t }}</p>
      </header>

      <main id="MainContent" class="password-page__main" role="main">
        {{ content_for_layout }}
      </main>

      <footer class="password-page__footer">
        <small>{{ 'password.powered_by_shopify_html' | t: shopify: shop.name }}</small>
      </footer>
    </div>
  </body>
</html>

<style>
  .password-page {
    min-block-size: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .password-page__wrapper {
    inline-size: 100%;
    max-inline-size: 28rem;
    padding: var(--container-padding);
    text-align: center;
  }

  .password-page__logo {
    inline-size: var(--logo-width);
    block-size: auto;
    margin-inline: auto;
  }

  .password-page__wordmark {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    font-size: 2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .password-page__tagline {
    margin-block-start: var(--gap-md);
    color: var(--color-foreground-muted);
    text-transform: uppercase;
    letter-spacing: 0.3rem;
    font-size: 0.875rem;
  }

  .password-page__main {
    margin-block: var(--gap-2xl);
  }

  .password-page__footer {
    color: var(--color-foreground-muted);
    font-size: 0.8125rem;
  }
</style>
