<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{{ localization.language.primary_direction | default: 'ltr' }}"
>
  <head>
    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'section-header.css' | asset_url | stylesheet_tag }}
    {{ 'section-footer.css' | asset_url | stylesheet_tag }}
    {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-card.css' | asset_url | stylesheet_tag }}
    {{ 'component-predictive-search.css' | asset_url | stylesheet_tag }}
    {{ 'section-product.css' | asset_url | stylesheet_tag }}
    {{ 'section-collection.css' | asset_url | stylesheet_tag }}
    {{ 'component-facets.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }},
        {% if settings.logo != blank %}
        "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
        {% endif %}
        "sameAs": [
          {%- assign social_links = settings.social_instagram | append: ',' | append: settings.social_tiktok | append: ',' | append: settings.social_facebook | append: ',' | append: settings.social_twitter | append: ',' | append: settings.social_youtube | split: ',' -%}
          {%- assign first = true -%}
          {%- for link in social_links -%}
            {%- assign trimmed = link | strip -%}
            {%- if trimmed != blank -%}
              {%- unless first -%},{%- endunless -%}
              {{ trimmed | json }}
              {%- assign first = false -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  </head>

  <body class="template-{{ template.name | handle }} template-{{ template | replace: '.', '-' | handle }}">
    <a class="skip-to-content visually-hidden-focusable" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer' %}

    <script src="{{ 'theme.js' | asset_url }}" type="module" defer></script>
  </body>
</html>
